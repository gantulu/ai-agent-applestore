{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apple Instagram Prompt Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "default": "awareness"
    },
    "audience": {
      "type": "string",
      "default": "Apple users and prospective buyers in Malaysia"
    },
    "category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "product",
            "promotion",
            "lifestyle",
            "education",
            "news",
            "comparison",
            "tips",
            "CAT-001",
            "CAT-002",
            "CAT-003",
            "CAT-004",
            "CAT-005",
            "CAT-006",
            "CAT-007"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": "auto"
    },
    "format": {
      "type": "string",
      "enum": [
        "single_image",
        "story"
      ]
    },
    "product_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_generation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "product_configuration": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "key_message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "campaign_details": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "supplied_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asset_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "topic",
    "format"
  ]
}
